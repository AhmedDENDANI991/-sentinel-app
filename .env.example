# ============================================================================
# GENIE_CIVIL_AI — variables d'environnement (exemple). NE PAS y mettre de secrets réels.
# Copier en .env et renseigner les valeurs locales.
# ============================================================================

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
# Secret JWT (générer une valeur aléatoire forte en prod, p.ex. openssl rand -hex 32)
JWT_SECRET=change-me-dev-only
JWT_EXPIRES_IN=3600
# Limites d'upload
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_MIME=application/pdf,image/vnd.dxf,model/iges,application/octet-stream

# --- Frontend ---
VITE_API_URL=http://localhost:3001

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=genie
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=genie_civil
DATABASE_URL=postgresql://genie:change-me-dev-only@localhost:5432/genie_civil

# --- Redis (jobs) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=genie-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-dev-only
S3_FORCE_PATH_STYLE=true

# --- Workers Python ---
CALC_SERVICE_QUEUE=genie:calc
REPORT_SERVICE_QUEUE=genie:report
IMPORT_SERVICE_QUEUE=genie:import

# --- Connecteurs externes (mocks par défaut — voir docs/architecture.md) ---
ROBOT_MODE=mock          # mock | live
REVIT_APS_MODE=mock      # mock | live (Autodesk Platform Services)
REVIT_APS_CLIENT_ID=
REVIT_APS_CLIENT_SECRET=
TEKLA_MODE=mock
ETABS_MODE=mock
TEDDS_MODE=mock

# --- Monitoring ---
SENTRY_DSN=
UPTIME_CHECK_URL=
